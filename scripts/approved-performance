#!/usr/bin/env python3
"""Evaluate approved contracts using only named regular blobs from a PR commit."""

import argparse
import json
from pathlib import Path
import subprocess
import tempfile


def entry(sha, path):
    data = subprocess.check_output(
        ["git", "--literal-pathspecs", "ls-tree", "-z", sha, "--", str(path)]
    )
    if not data:
        return None
    info, actual = data.rstrip(b"\0").split(b"\t", 1)
    mode, kind, oid = info.decode().split()
    if actual != bytes(path) or kind != "blob" or mode not in {"100644", "100755"}:
        raise ValueError(f"expected a regular candidate file: {path}")
    return mode, oid


def stage(contract, sha, target):
    if not entry(sha, contract):
        raise ValueError(f"approved contract removed: {contract}")
    record = json.loads(contract.read_bytes())
    bench = record["benchmark"]
    directory = Path(bench.get("candidate_root", contract.parent))
    if directory.is_absolute() or ".." in directory.parts:
        raise ValueError("invalid candidate_root")
    explicit = bench.get("candidate_files")
    if explicit is None:
        explicit = []
        for arg in bench["candidate"]:
            path = Path(arg)
            if (
                not path.is_absolute()
                and ".." not in path.parts
                and ((directory / path).is_file() or entry(sha, directory / path))
            ):
                explicit.append(arg)
    names = set(explicit)
    if "scaling" in record:
        names.update(record["scaling"]["implementations"][record["choice"]]["files"])
    for name in names:
        path = Path(name)
        if path.is_absolute() or ".." in path.parts or not path.parts:
            raise ValueError("invalid approved file")
        blob = entry(sha, directory / path)
        if not blob:
            raise ValueError(f"missing candidate file: {path}")
        mode, oid = blob
        dest = target / path
        dest.parent.mkdir(parents=True, exist_ok=True)
        with dest.open("xb") as f:
            subprocess.run(["git", "cat-file", "blob", oid], stdout=f, check=True)
        dest.chmod(int(mode, 8) & 0o777)
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("sha")
    parser.add_argument("artifact", type=Path)
    args = parser.parse_args()
    sha = subprocess.check_output(
        ["git", "rev-parse", "--verify", "--end-of-options", args.sha + "^{commit}"],
        text=True,
    ).strip()
    base = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    contracts = sorted(Path(".performance").glob("**/contract.json")) + [
        Path("plugins/deadlion/evals/indexed-membership/contract.json")
    ]
    failed = False
    with args.artifact.open("w") as artifact:
        for contract in contracts:
            try:
                with tempfile.TemporaryDirectory() as tmp:
                    record = stage(contract, sha, Path(tmp))
                    result = subprocess.run(
                        [
                            "plugins/deadlion/skills/performance/scripts/dl-perf-gate",
                            contract,
                            "--isolated",
                            "--candidate-dir",
                            tmp,
                        ],
                        capture_output=True,
                        text=True,
                    )
                    evidence = json.loads(result.stdout)
                    if result.returncode and evidence.get("status") == "VERIFIED":
                        raise ValueError("inconsistent evaluator exit")
                    if evidence.get("status") == "INCONCLUSIVE":
                        evidence["follow_up"] = (
                            "Remeasure the same SHAs on the project performance runner."
                        )
                        print(
                            f"::warning::{contract}: INCONCLUSIVE; see performance-evidence"
                        )
                    failed |= evidence.get("status") != "VERIFIED" and not (
                        evidence.get("status") == "INCONCLUSIVE"
                        and record.get("ci_inconclusive") == "advisory"
                    )
            except (
                OSError,
                subprocess.SubprocessError,
                ValueError,
                KeyError,
                TypeError,
            ) as error:
                evidence = dict(status="NOT VERIFIED", reason=str(error))
                failed = True
            print(
                json.dumps(
                    dict(
                        **evidence,
                        base_sha=base,
                        candidate_sha=sha,
                        approved_contract=str(contract),
                    )
                ),
                file=artifact,
                flush=True,
            )
    return int(failed)


if __name__ == "__main__":
    raise SystemExit(main())
