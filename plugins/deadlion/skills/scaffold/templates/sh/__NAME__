#!/bin/sh
# __NAME__ - copy files to standard output
# See LICENSE file for copyright and license details.
set -eu

# configuration
VERSION=0.1

die() {
	echo "__NAME__: $*" >&2
	exit 1
}

usage() {
	echo 'usage: __NAME__ [-v] [file...]' >&2
	exit 1
}

while getopts v opt; do
	case $opt in
	v) echo "__NAME__-$VERSION"; exit 0 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ $# -gt 0 ] || set -- -
for f; do
	if [ "$f" = - ]; then
		cat || die '<stdin>: read error'
	elif [ ! -r "$f" ] || [ -d "$f" ]; then
		die "$f: cannot read"
	else
		cat -- "$f" || die "$f: read error"
	fi
done
