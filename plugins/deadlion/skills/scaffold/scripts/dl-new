#!/usr/bin/env python3
"""dl-new: create a suckless-style program skeleton from a template.

Usage: dl-new LANG NAME [DEST]

LANG is a directory under ../templates (c, rust, sh). NAME matches
^[a-z][a-z0-9-]{0,31}$. DEST defaults to projects/NAME. __NAME__, __YEAR__
and __AUTHOR__ are replaced in file names and contents; a template file
named `gitignore` becomes `.gitignore`. Nothing is written when any target
file exists. Silent on success. Exit 0 ok, 2 usage or IO error.
"""

import datetime
import re
import shutil
import subprocess
import sys
from pathlib import Path

TEMPLATES = Path(__file__).resolve().parent.parent / "templates"
NAME = "[a-z][a-z0-9-]{0,31}"


class UsageError(Exception):
    """Bad invocation, existing target or IO error; reported with exit 2."""


def languages():
    return sorted(d.name for d in TEMPLATES.iterdir() if d.is_dir())


def author(name):
    """Return `git config user.name`, or a generic author for NAME."""
    try:
        out = subprocess.run(["git", "config", "user.name"],
                             capture_output=True, text=True).stdout.strip()
    except OSError:
        out = ""
    return out or f"The {name} authors"


def substitute(text, subst):
    for key, value in subst.items():
        text = text.replace(key, value)
    return text


def targets(src, dest, subst):
    """Return [(template file, target path)] for the template tree SRC."""
    pairs = []
    for path in sorted(p for p in src.rglob("*") if p.is_file()):
        parts = [substitute(p, subst) for p in path.relative_to(src).parts]
        if parts[-1] == "gitignore":
            parts[-1] = ".gitignore"
        pairs.append((path, dest.joinpath(*parts)))
    return pairs


def create(pairs, subst):
    """Copy every template file to its target, substituting contents."""
    for src, dst in pairs:
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        text = substitute(src.read_text(encoding="utf-8"), subst)
        dst.write_text(text, encoding="utf-8")


def parse(args):
    """Validate ARGS; return (template dir, NAME, DEST)."""
    if len(args) not in (2, 3):
        raise UsageError("usage: dl-new LANG NAME [DEST]")
    lang, name = args[0], args[1]
    have = languages()
    if lang not in have:
        raise UsageError(f"unknown language {lang} (have: {' '.join(have)})")
    if not re.fullmatch(NAME, name):
        raise UsageError(f"bad name {name} (want ^{NAME}$)")
    dest = Path(args[2]) if len(args) == 3 else Path("projects", name)
    return TEMPLATES / lang, name, dest


def main(argv):
    src, name, dest = parse(argv[1:])
    subst = {"__NAME__": name, "__AUTHOR__": author(name),
             "__YEAR__": str(datetime.date.today().year)}
    pairs = targets(src, dest, subst)
    for _, dst in pairs:
        if dst.exists():
            raise UsageError(f"{dst}: exists")
    create(pairs, subst)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except UsageError as err:
        print(f"dl-new: {err}", file=sys.stderr)
        sys.exit(2)
    except OSError as err:
        print(f"dl-new: {err.filename}: {err.strerror}", file=sys.stderr)
        sys.exit(2)
