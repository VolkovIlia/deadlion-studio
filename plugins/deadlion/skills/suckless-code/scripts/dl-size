#!/usr/bin/env python3
"""dl-size: report source files and Python functions that exceed size limits.

Usage: dl-size [--hook] [PATH...]

Prints `path:line: message` per violation on stdout. Exit 0 clean,
1 violations, 2 usage or IO error. `--hook` reads Claude hook JSON on stdin,
checks tool_input.file_path, prints violations on stderr and exits 2.
Extensionless files starting with `#!` count as source. Non-Python sources
are measured by `lizard` when it is on PATH; otherwise one notice goes to
stderr in CLI mode.
"""

import ast
import json
import os
import shutil
import subprocess
import sys

# Limits: config in source, env override.
#   env var       default  meaning
#   DL_MAX_FILE   500      max lines per source file
#   DL_MAX_FUNC   50       max non-blank, non-comment lines per function
#   DL_HOOKS      1        0 makes --hook exit 0 immediately
LIMITS = {"DL_MAX_FILE": 500, "DL_MAX_FUNC": 50}

SOURCE_EXTS = frozenset(
    ".py .js .jsx .ts .tsx .mjs .cjs .go .rs .c .h .cc .cpp .hpp .java .kt"
    " .swift .cs .rb .php .sh .lua .zig .vue .svelte".split()
)
SKIP_DIRS = frozenset(
    ".git node_modules vendor dist build target __pycache__ .venv venv".split()
)


class UsageError(Exception):
    """Bad invocation or unreadable input; reported with exit 2."""


def limit(name):
    """Return the integer limit for NAME, honouring the environment."""
    raw = os.environ.get(name, "")
    try:
        return int(raw) if raw else LIMITS[name]
    except ValueError:
        raise UsageError(f"{name} must be an integer, got {raw!r}")


def head(path):
    """Return the first 64 bytes of PATH, or b"" when unreadable."""
    try:
        with open(path, "rb") as handle:
            return handle.read(64)
    except OSError:
        return b""


def is_source(path):
    """True for known source extensions and extensionless #! scripts."""
    ext = os.path.splitext(path)[1].lower()
    if ext:
        return ext in SOURCE_EXTS
    return head(path).startswith(b"#!")


def is_python(path):
    """True for .py files and extensionless scripts with a python #! line."""
    ext = os.path.splitext(path)[1].lower()
    if ext:
        return ext == ".py"
    first = head(path).split(b"\n", 1)[0]
    return first.startswith(b"#!") and b"python" in first


def git_files(directory):
    """List tracked and untracked-not-ignored files under DIRECTORY, or None."""
    cmd = ["git", "-C", directory, "ls-files", "-z", "--cached", "--others",
           "--exclude-standard", "--", "."]
    try:
        out = subprocess.run(cmd, capture_output=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    names = sorted({n for n in out.decode().split("\0") if n})
    return [os.path.join(directory, n) for n in names]


def walk_files(directory):
    """List files under DIRECTORY, skipping vendored and generated dirs."""
    found = []
    for root, dirs, files in os.walk(directory):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        found.extend(os.path.join(root, f) for f in sorted(files))
    return found


def collect(paths):
    """Expand PATHS into the existing source files they denote."""
    files = []
    for path in paths:
        if os.path.isdir(path):
            listed = git_files(path)
            listed = walk_files(path) if listed is None else listed
            files.extend(f for f in listed if os.path.isfile(f))
        elif os.path.isfile(path):
            files.append(path)
        else:
            raise UsageError(f"{path}: no such file or directory")
    return [f for f in files if is_source(f)]


def count_function_lines(node, lines):
    """Count non-blank, non-comment body lines of NODE, excluding the docstring."""
    if node.end_lineno is None or not node.body:
        return 0
    first = node.body[0]
    start = first.lineno
    if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant):
        start = (first.end_lineno or first.lineno) + 1
    count = 0
    for line in lines[start - 1:node.end_lineno]:
        text = line.strip()
        if text and not text.startswith("#"):
            count += 1
    return count


def check_functions(path, text, max_func):
    """Return violations for Python functions in TEXT longer than MAX_FUNC."""
    try:
        tree = ast.parse(text, filename=path)
    except (SyntaxError, ValueError):
        return []
    lines = text.splitlines()
    found = []
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            n = count_function_lines(node, lines)
            if n > max_func:
                found.append((node.lineno, f"{path}:{node.lineno}: function "
                              f"{node.name} has {n} lines (max {max_func})"))
    return [msg for _, msg in sorted(found)]


def check_file(path, max_file, max_func):
    """Return violations for one source file."""
    try:
        with open(path, "rb") as handle:
            text = handle.read().decode("utf-8", errors="replace")
    except OSError as err:
        raise UsageError(f"{path}: {err.strerror}")
    found = []
    n = len(text.splitlines())
    if n > max_file:
        found.append(f"{path}:1: file has {n} lines (max {max_file})")
    if is_python(path):
        found.extend(check_functions(path, text, max_func))
    return found


def run_lizard(files, max_func):
    """Return (warning lines, unchecked count) for non-Python FILES."""
    others = [f for f in files if not is_python(f)]
    exe = shutil.which("lizard")
    if not others:
        return [], 0
    if exe is None:
        return [], len(others)
    cmd = [exe, "-L", str(max_func), "-w", *others]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True).stdout
    except OSError:
        return [], len(others)
    return [line for line in out.splitlines() if line.strip()], 0


def check(paths):
    """Return (violations, files whose functions were not measured)."""
    max_file, max_func = limit("DL_MAX_FILE"), limit("DL_MAX_FUNC")
    files = collect(paths)
    found = []
    for path in files:
        found.extend(check_file(path, max_file, max_func))
    lizard, skipped = run_lizard(files, max_func)
    return found + lizard, skipped


def hook():
    """Run in Claude hook mode; return the exit status."""
    if os.environ.get("DL_HOOKS") == "0":
        return 0
    try:
        path = json.load(sys.stdin)["tool_input"]["file_path"]
    except (ValueError, KeyError, TypeError):
        return 0
    if not isinstance(path, str) or not os.path.isfile(path) \
            or not is_source(path):
        return 0
    found, _ = check([path])
    for line in found:
        print(line, file=sys.stderr)
    return 2 if found else 0


def main(argv):
    args = argv[1:]
    if args[:1] == ["--hook"]:
        return hook() if len(args) == 1 else usage()
    if any(a.startswith("-") for a in args):
        return usage()
    found, skipped = check(args or ["."])
    if skipped:
        print(f"dl-size: lizard not on PATH; function length of {skipped} "
              "non-Python files not checked (pipx install lizard)",
              file=sys.stderr)
    for line in found:
        print(line)
    return 1 if found else 0


def usage():
    print("dl-size: usage: dl-size [--hook] [PATH...]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except UsageError as err:
        print(f"dl-size: {err}", file=sys.stderr)
        sys.exit(2)
