#!/usr/bin/env python3
"""Execute a trusted contract from its directory and report fresh evidence."""
import argparse
import json
import math
from pathlib import Path
import shlex
import subprocess
import sys


RESOURCE_KEYS = {"peak_rss_kib", "user_cpu_s", "system_cpu_s", "voluntary_switches", "involuntary_switches"}


def enforce_resources(scripts, path, contract, candidate_dir, report):
    budgets = contract["budget"]
    options = []
    for key in sorted(RESOURCE_KEYS & budgets.keys()):
        options.extend(["--max", f"{key}={budgets[key]}"])
    if not options:
        return
    command = [scripts / "dl-profile", *options, "resources", "--", *contract["benchmark"]["candidate"]]
    with (path.parent / contract["workload"]).open("rb") as workload:
        trial = subprocess.run(command, stdin=workload, stdout=subprocess.PIPE,
                               cwd=candidate_dir or path.parent)
    resource_report = json.loads(trial.stdout)
    report["resources"] = resource_report
    if trial.returncode:
        report["status"] = "ERROR" if resource_report["status"] == "ERROR" else "NOT VERIFIED"


def run(path, candidate_dir):
    scripts = Path(__file__).resolve().parent
    contract = json.loads(path.read_bytes())
    subprocess.run([scripts / "dl-contract", path], stdout=sys.stderr, check=True)
    spec = contract["benchmark"]
    budgets = contract["budget"]
    if set(budgets) - RESOURCE_KEYS - {"wall_time_regression_fraction", "max_wall_ratio"}:
        raise ValueError("contract contains a budget this runner cannot verify")
    tolerance = budgets["wall_time_regression_fraction"]
    ceiling = min(1 + tolerance, budgets.get("max_wall_ratio", math.inf))
    args = [scripts / "dl-perf", "--input", contract["workload"], "--expected", spec["expected"],
            "--build", contract["build"], "--tolerance", str(tolerance)]
    if candidate_dir:
        args.extend(("--candidate-dir", str(candidate_dir.resolve())))
    for key in ("baseline", "candidate"):
        argv = spec[key]
        if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
            raise ValueError(f"{key} must be a nonempty argv array")
        args.extend(("--" + key, shlex.join(argv)))
    trial = subprocess.run(args, cwd=path.parent, stdout=subprocess.PIPE, check=False)
    report = json.loads(trial.stdout)
    if trial.returncode == 0:
        low, high = report["interval"]
        if low > ceiling:
            report["status"] = "PERFORMANCE REGRESSION"
        elif high > ceiling:
            report["status"] = "INCONCLUSIVE"
    if report["status"] == "VERIFIED":
        enforce_resources(scripts, path, contract, candidate_dir, report)
    report.update(contract=str(path), max_wall_ratio=ceiling)
    print(json.dumps(report))
    return {"VERIFIED": 0, "PERFORMANCE REGRESSION": 1, "ERROR": 1}.get(report["status"], 2)


if __name__ == "__main__":
    try:
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument("contract", type=Path)
        parser.add_argument("--candidate-dir", type=Path)
        args = parser.parse_args()
        sys.exit(run(args.contract.resolve(), args.candidate_dir))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps(dict(status="NOT VERIFIED", reason=str(error))))
        sys.exit(2)
