#!/usr/bin/env python3
"""Report native and structural performance diagnostics for explicit or Git-selected files."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import sys


def git_paths(*args):
    data = subprocess.check_output(["git", *args, "-z"])
    return [Path(os.fsdecode(path)) for path in data.split(b"\0") if path]


def inspect(files, *, source=None, deep=False):
    rules = "PERF,C901,SIM102,SIM114" if deep else "PERF"
    result = subprocess.run(["ruff", "check", "--isolated", "--no-cache", "--select", rules,
                             "--output-format", "json", *files],
                            input=source,
                            capture_output=True, text=True, timeout=60)
    if result.returncode not in (0, 1):
        raise ValueError(result.stderr.strip() or "Ruff failed")
    diagnostics = json.loads(result.stdout)
    if not isinstance(diagnostics, list) or bool(diagnostics) != bool(result.returncode):
        raise ValueError("inconsistent Ruff diagnostic result")
    for item in diagnostics:
        structural_hint = item["code"] in ("C901", "SIM102", "SIM114")
        if not (structural_hint or str(item["code"]).startswith("PERF")):
            raise ValueError(f'Ruff could not analyze {item["filename"]}: {item["message"]}')
        end = item["end_location"]
        region = dict(startLine=item["location"]["row"], startColumn=item["location"]["column"],
                      endLine=end["row"], endColumn=end["column"], unit="character")
        yield dict(source="Ruff", range=region, file=item["filename"], line=item["location"]["row"], rule=item["code"],
                   severity="INFO" if structural_hint else "WARNING", confidence="heuristic",
                   explanation=item["message"], confirm="Review control flow and semantics." if structural_hint
                   else "Measure this path on representative input and verify semantics.")

    if not deep:
        from python_hints import hints
        if source is not None:
            yield from hints(files[1], source)
        else:
            for file in files[1:]:
                yield from hints(file, Path(file).read_text())


def cached_python(files, directory):
    # Only clean isolated Python snapshots are cached. CI always scans fresh.
    binary = shutil.which("ruff")
    if not binary:
        raise ValueError("ruff missing")
    stat = Path(binary).stat()
    identity = (binary, stat.st_dev, stat.st_ino, stat.st_ctime_ns, Path(__file__).stat().st_ctime_ns,
                Path(__file__).with_name("python_hints.py").stat().st_ctime_ns)
    directory.mkdir(parents=True, exist_ok=True)
    for path in files:
        source = path.read_text(encoding="utf-8")
        key = hashlib.sha256(repr((identity, str(path.resolve()), source)).encode()).hexdigest()
        slot = directory / (key[:2] + ".clean")
        try:
            if slot.read_text() == key:
                continue
        except FileNotFoundError:
            pass
        findings = list(inspect(["--stdin-filename", str(path.resolve()), "-"], source=source))
        if findings:
            yield from findings
        else:
            with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as tmp:
                tmp.write(key)
            os.replace(tmp.name, slot)


AST_SUFFIXES = {".c", ".cpp", ".cc", ".cxx", ".js", ".ts", ".java", ".go", ".kt", ".rs"}
SUFFIXES = AST_SUFFIXES | {".py"}


def structural(files):
    config = Path(__file__).resolve().parents[1] / "ast" / "sgconfig.yml"
    result = subprocess.run(["ast-grep", "scan", "-c", config, "--json=compact", "--", *files],
                            capture_output=True, text=True, timeout=60, check=True)
    for item in json.loads(result.stdout):
        start, end = item["range"]["start"], item["range"]["end"]
        region = dict(startLine=start["line"] + 1, startColumn=start["column"] + 1,
                      endLine=end["line"] + 1, endColumn=end["column"] + 1, unit="ast-grep column")
        yield dict(source="ast-grep", range=region, file=item["file"], line=item["range"]["start"]["line"] + 1,
                   rule=item["ruleId"], severity="WARNING", confidence="heuristic",
                   explanation=item["message"], confirm="Profile on the target workload.")


def post_edit():
    path = Path(json.load(sys.stdin)["tool_input"]["file_path"])
    if path.suffix not in SUFFIXES:
        return
    findings = list(inspect(["--", path]) if path.suffix == ".py" else structural([path]))
    if findings:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
                         "additionalContext": json.dumps(findings)}}))


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--stdin-name", type=Path, help="analyze Python source read from stdin")
    mode.add_argument("--all", action="store_true")
    mode.add_argument("--changed", action="store_true")
    parser.add_argument("--infer-cost", action="store_true", help="capture trusted Java sources with Infer Cost")
    parser.add_argument("--native", action="store_true", help="run installed project-aware tools for trusted source")
    parser.add_argument("--deep", action="store_true", help="also apply structural hints to Python")
    parser.add_argument("--available", action="store_true", help="use the available isolated analyzers")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--cache-dir", type=Path, help="private directory for verified clean Ruff snapshots")
    parser.add_argument("paths", nargs="*", type=Path)
    return parser.parse_args()


def isolated_analyzers(files, args):
    python = [p for p in files if p.suffix == ".py"]
    native = files if args.deep else [p for p in files if p.suffix in AST_SUFFIXES]
    findings = []
    checked = []
    unavailable = []
    if python:
        if args.available and not shutil.which("ruff"):
            from python_hints import hints
            unavailable.append("ruff")
            for path in python:
                findings.extend(hints(path, path.read_text()))
        elif args.cache_dir and not args.deep:
            findings.extend(cached_python(python, args.cache_dir))
            checked.append("ruff")
        else:
            findings.extend(inspect(["--", *python], deep=args.deep))
            checked.append("ruff")
    if native:
        if args.available and not shutil.which("ast-grep"):
            unavailable.append("ast-grep")
        else:
            findings.extend(structural(native))
            checked.append("ast-grep")
    return findings, checked, unavailable


def main():
    args = arguments()
    if args.stdin_name is not None:
        if args.paths or args.deep or args.stdin_name.suffix != ".py":
            parser.error("--stdin-name expects one Python filename and no paths")
        findings = list(inspect(["--stdin-filename", str(args.stdin_name), "-"], source=sys.stdin.read()))
        print(json.dumps(dict(status="CHECKED", scope="Ruff PERF and fast Python AST", files=1, diagnostics=findings)))
        return
    if bool(args.paths) == bool(args.all or args.changed):
        parser.error("select paths, --changed, or --all")
    paths = args.paths
    if args.all or args.changed:
        paths = git_paths("ls-files") if args.all else git_paths("diff", "--name-only", "HEAD")
        paths += git_paths("ls-files", "--others", "--exclude-standard")
        paths = [p for p in paths if p.is_file() and p.suffix in SUFFIXES]
    files = sorted(set(paths))
    if any(not p.is_file() or p.suffix not in SUFFIXES for p in files):
        raise ValueError("unsupported or missing input file")
    findings, checked, unavailable = isolated_analyzers(files, args)
    coverage = {}
    if args.infer_cost:
        from native_diagnostics import infer_cost
        findings.extend(infer_cost(files))
    if args.native:
        from native_diagnostics import review
        findings.extend(review(files, coverage))
    from diagnostic_report import aggregate
    findings = aggregate(findings)
    report = dict(status="CHECKED" if files else "NOT APPLICABLE", scope="Ruff PERF and Deadlion AST rules",
                  files=len(files), diagnostics=findings)
    report["checked_tools"] = checked
    if unavailable:
        report["unavailable_tools"] = unavailable
    if args.infer_cost:
        report["scope"] += " and Infer Cost"
    if args.native:
        report["native_tools"] = coverage
    if args.json:
        print(json.dumps(report))
    else:
        print(f"{report['status']} ({len(files)} files)")
        for item in findings:
            print("{file}:{line} {rule} {severity} [{confidence}] {explanation} {confirm}".format(**item))


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--hook"]:
            post_edit()
        else:
            main()
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:
        print(json.dumps(dict(status="NOT VERIFIED", reason=str(error))))
        sys.exit(2)
