#!/usr/bin/env python3
"""Start/resume OMP native autoresearch in an independent disposable clone."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import time


def new_workspace(directory, args):
    if not args.goal or not (1 <= args.iterations <= 100 and 1 <= args.seconds <= 86400):
        raise ValueError("supply a goal, 1..100 iterations and 1..86400 seconds")
    if args.tokens < 0 or args.patience < 1:
        raise ValueError("invalid token budget or patience")
    if args.memory_mib < 1 or not 1 <= args.cpu_percent <= 10000:
        raise ValueError("invalid MemoryMax or CPUQuota")
    source = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
    common = Path(subprocess.check_output(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], text=True).strip())
    check = args.check.resolve() if args.check else None
    if not check or not check.is_relative_to(source) or not check.is_file() or not os.access(check, os.X_OK):
        raise ValueError("supply --check with a trusted executable in the source tree")
    revision = subprocess.check_output(["git", "rev-parse", "--verify", "HEAD"], text=True).strip()
    directory.mkdir(mode=0o700)
    repo = directory / "repo"
    subprocess.run(["git", "clone", "--local", "--no-hardlinks", "--no-checkout",
                    ".", str(repo)], check=True)
    subprocess.run(["git", "-C", repo, "remote", "remove", "origin"], check=True)
    subprocess.run(["git", "-C", repo, "checkout", "-b", "autoresearch/deadlion", revision], check=True)
    limits = dict(source=str(source), common=str(common), check=str(check), goal=args.goal, iterations=args.iterations, revision=revision,
                  memory_mib=args.memory_mib, cpu_percent=args.cpu_percent, tokens=args.tokens, patience=args.patience,
                  deadline=int(time.time() * 1000) + args.seconds * 1000)
    (directory / "limits.json").write_text(json.dumps(limits))


def launch(directory, pause_after):
    limits = json.loads((directory / "limits.json").read_text())
    remaining = int(limits["deadline"] / 1000 - time.time())
    if remaining < 1 or (directory / "completed").exists():
        raise ValueError("experiment budget exhausted")
    extension = Path(__file__).resolve().with_name("evolution.mjs")
    env = {**os.environ, "DL_EXPERIMENT": str(directory),
           "DL_PAUSE_AFTER": str(pause_after), "OMP_AUTORESEARCH_DB_DIR": str(directory / "history")}
    supervisor = extension.with_name("experiment-rpc.py")
    readonly = [limits["source"], limits["common"], str(directory / "limits.json"),
                str(supervisor.parent)]
    mounts = [arg for path in readonly for arg in ("--ro-bind", path, path)]
    command = ["systemd-run", "--user", "--scope", "--quiet",
               f"--property=MemoryMax={limits['memory_mib']}M",
               f"--property=CPUQuota={limits['cpu_percent']}%", "--", "timeout", "--kill-after=5", str(remaining),
               "bwrap", "--die-with-parent", "--bind", "/", "/", "--dev", "/dev", *mounts, "--unsetenv", "SSH_AUTH_SOCK",
               "--", "python3", str(supervisor)]
    return subprocess.run(command, env=env, cwd=directory / "repo").returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workspace", type=Path)
    parser.add_argument("--goal")
    parser.add_argument("--check", type=Path, help="trusted correctness and budget evaluator")
    parser.add_argument("--iterations", type=int, default=4)
    parser.add_argument("--seconds", type=int, default=300)
    parser.add_argument("--tokens", type=int, default=0, help="stop at reported foreground token usage (0 disables)")
    parser.add_argument("--patience", type=int, default=3, help="stop after consecutive discarded runs")
    parser.add_argument("--memory-mib", type=int, default=2048)
    parser.add_argument("--cpu-percent", type=int, default=100)
    parser.add_argument("--pause-after", type=int, default=0, help="pause after this many logged attempts")
    parser.add_argument("--resume", action="store_true")
    args = parser.parse_args()
    if args.pause_after < 0:
        parser.error("pause-after must be nonnegative")
    directory = args.workspace.resolve()
    if not args.resume:
        if directory.is_relative_to(Path(subprocess.check_output(
                ["git", "rev-parse", "--show-toplevel"], text=True).strip()).resolve()):
            parser.error("create the experiment outside the source tree")
        new_workspace(directory, args)
    with (directory / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return launch(directory, args.pause_after)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        raise SystemExit(f"NOT VERIFIED: {error}")
